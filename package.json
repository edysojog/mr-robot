{
  "name": "mrrobotbot",
  "version": "0.1.0",
  "description": "Terminal-styled local security auditor: Semgrep + Claude two-pass code scan.",
  "author": "MrRobotBot",
  "main": "src/main/index.js",
  "private": true,
  "license": "MIT",
  "bin": {
    "mrrobot": "src/cli/mrrobot.js"
  },
  "scripts": {
    "start": "electron .",
    "scan": "node src/cli/index.js",
    "chat": "node src/cli/chat.js",
    "chat:tui": "bun run src/cli/chatOpentui.tsx",
    "dist": "electron-builder build --win",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@opentui/core": "^0.5.4",
    "@opentui/solid": "^0.5.4",
    "groq-sdk": "^1.5.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "openai": "^7.4.0",
    "react": "^19.2.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  }
}
